{% extends 'schedulr/_layouts/cp' %}
{% import '_includes/forms' as forms %}
{% import 'schedulr/_components/_macros' as ui %}

{% set selectedSubnavItem = 'subscribers' %}
{% set crumbs = [
    { label: 'Schedulr'|t('schedulr'), url: url('schedulr') },
    { label: 'Subscribers'|t('schedulr'), url: url('schedulr/subscribers') },
] %}

{% block content %}
    {#
      Every column stored about this person, listed. The privacy screen promises this list is
      complete, and a promise like that is only worth making where it can be checked.
    #}
    <h2 class="first">{{ 'What is stored'|t('schedulr') }}</h2>
    <table class="data fullwidth">
        <tbody>
            <tr><th scope="row">{{ 'State'|t('schedulr') }}</th><td>{{ ui.subscriberState(subscriber) }}</td></tr>
            {% for label, value in {
                ('Visitor ID'|t('schedulr')): subscriber.visitorId,
                ('Craft user'|t('schedulr')): subscriber.userId ? (subscriber.getUser().username ?? subscriber.userId) : null,
                ('Email'|t('schedulr')): subscriber.getEmailAddress(),
                ('Language'|t('schedulr')): subscriber.language,
                ('Time zone'|t('schedulr')): subscriber.timezone ?? ui.muted('Unknown, so the site’s own is used'|t('schedulr')),
                ('Platform'|t('schedulr')): subscriber.platform,
                ('User agent'|t('schedulr')): subscriber.userAgent ?? ui.muted('Not stored'|t('schedulr')),
                ('Visits'|t('schedulr')): subscriber.visits|number_format,
                ('Notifications received'|t('schedulr')): subscriber.notifiedCount|number_format,
                ('Consecutive push failures'|t('schedulr')): subscriber.failures|number_format,
            } %}
                <tr><th scope="row">{{ label }}</th><td>{{ value ?? ui.muted('None'|t('schedulr')) }}</td></tr>
            {% endfor %}

            {% for label, date in {
                ('First seen'|t('schedulr')): subscriber.dateFirstSeen,
                ('Last seen'|t('schedulr')): subscriber.dateLastSeen,
                ('Subscribed to push'|t('schedulr')): subscriber.dateSubscribed,
                ('Declined push'|t('schedulr')): subscriber.dateDeclined,
                ('Last notified'|t('schedulr')): subscriber.dateLastNotified,
            } %}
                <tr><th scope="row">{{ label }}</th><td>{{ date ? date|datetime('short') : ui.muted('Never'|t('schedulr')) }}</td></tr>
            {% endfor %}

            <tr>
                <th scope="row">{{ 'Push endpoint'|t('schedulr') }}</th>
                <td>
                    {#
                      Never shown in full and never exported. An endpoint is a credential: anyone
                      holding one can unsubscribe that device. The host is enough to tell Firefox from
                      Chrome, which is the only reason anybody looks.
                    #}
                    {% if subscriber.endpoint %}
                        <span class="light">{{ subscriber.endpoint|split('/')|slice(0, 3)|join('/') }}/…</span>
                    {% else %}
                        {{ ui.muted('None'|t('schedulr')) }}
                    {% endif %}
                </td>
            </tr>
        </tbody>
    </table>

    {% if canManage %}
        <hr>

        {{ forms.textareaField({
            label: 'Tags'|t('schedulr'),
            instructions: 'One per line. A bare word, or {syntax}.'|t('schedulr', { syntax: '`key=value`' }),
            id: 'tags',
            name: 'tags',
            rows: 4,
            class: 'code',
            value: tags|keys|map(k => tags[k] ? k ~ '=' ~ tags[k] : k)|join("\n"),
        }) }}

        {#
          This screen has no page form, so these post over Ajax rather than through one. Each goes
          through SchedulrCp.post() for a consistent busy state, and the two destructive ones through
          SchedulrCp.confirmThen(), because `data-confirm` on a plain button is otherwise inert.
        #}
        <div class="flex">
            {{ forms.button({ id: 'save-tags', label: 'Save tags'|t('schedulr'), class: 'submit', spinner: true }) }}
            {{ forms.button({
                id: 'unsubscribe',
                label: 'Unsubscribe'|t('schedulr'),
                spinner: true,
                attributes: { data: { confirm: 'Unsubscribe this person from every channel?'|t('schedulr') } },
            }) }}
            {{ forms.button({
                id: 'delete-subscriber',
                label: 'Delete'|t('app'),
                class: 'caution',
                spinner: true,
                attributes: { data: { confirm: 'Delete this subscriber? Their delivery history is kept.'|t('schedulr') } },
            }) }}
        </div>
    {% endif %}

    <hr>

    <h2>{{ 'Delivery history'|t('schedulr') }}</h2>

    {% if deliveries|length %}
        <table class="data fullwidth">
            <thead>
                <tr>
                    <th scope="col">{{ 'When'|t('schedulr') }}</th>
                    <th scope="col">{{ 'Notification'|t('schedulr') }}</th>
                    <th scope="col">{{ 'Channel'|t('schedulr') }}</th>
                    <th scope="col">{{ 'Status'|t('schedulr') }}</th>
                    <th scope="col">{{ 'Detail'|t('schedulr') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for row in deliveries %}
                    <tr>
                        <td class="light">{{ row.dateCreated|datetime('short') }}</td>
                        <td>
                            {% if row.notificationId %}
                                <a href="{{ url('schedulr/notifications/' ~ row.notificationId) }}">{{ row.title ?? ('#' ~ row.notificationId) }}</a>
                            {% else %}
                                {{ ui.muted('(deleted)'|t('schedulr')) }}
                            {% endif %}
                        </td>
                        <td>{{ ui.channelLabel(row.channel) }}</td>
                        <td>{{ ui.deliveryStatus(row.status, row.statusCode) }}</td>
                        <td class="light smalltext">{{ row.error ? row.error|slice(0, 120) : '' }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p class="zilch small">{{ 'Nothing has been sent to this person yet.'|t('schedulr') }}</p>
    {% endif %}

    {% if canManage %}
        {% include 'schedulr/_components/_cp-js' %}

        {% js %}
            var subscriberId = {{ subscriber.id }};

            $('#save-tags').on('click', function() {
                SchedulrCp.post($(this), 'schedulr/subscribers/save-tags', { subscriberId: subscriberId, tags: $('#tags').val() });
            });

            SchedulrCp.confirmThen('#unsubscribe', function($button) {
                SchedulrCp.post($button, 'schedulr/subscribers/unsubscribe', { subscriberId: subscriberId }).then(function(response) {
                    if (response) { window.location.reload(); }
                });
            });

            SchedulrCp.confirmThen('#delete-subscriber', function($button) {
                SchedulrCp.post($button, 'schedulr/subscribers/delete', { subscriberId: subscriberId }).then(function(response) {
                    if (response) { window.location.href = Craft.getCpUrl('schedulr/subscribers'); }
                });
            });
        {% endjs %}
    {% endif %}
{% endblock %}

{% extends 'schedulr/_layouts/cp' %}
{% import '_includes/forms' as forms %}
{% import 'schedulr/_components/_macros' as ui %}

{% set fullPageForm = true %}
{% set selectedSubnavItem = 'notifications' %}
{% set crumbs = [
    { label: 'Schedulr'|t('schedulr'), url: url('schedulr') },
    { label: 'Notifications'|t('schedulr'), url: url('schedulr/notifications') },
] %}

{#
  "Save and send now" is a form action, not a checkbox, and has its own permission. Writing a
  notification and putting it on a hundred thousand lock screens are different acts, and a save must
  never quietly do the second. It lives in Craft's save menu, which is what honours `confirm`.
#}
{% if canSend %}
    {% set formActions = [
        {
            label: 'Save and send now'|t('schedulr'),
            params: { sendNow: 1 },
            confirm: 'Send this notification now? It cannot be recalled.'|t('schedulr'),
        },
    ] %}
{% endif %}

{% block content %}
    {{ actionInput('schedulr/notifications/save') }}
    {{ redirectInput('schedulr/notifications/{id}') }}
    {% if notification.id %}{{ hiddenInput('notificationId', notification.id) }}{% endif %}
    {{ hiddenInput('siteId', notification.siteId, { id: 'siteId' }) }}

    {{ forms.textField({
        first: true,
        label: 'Title'|t('app'),
        instructions: 'What appears in bold on the lock screen. Around 120 characters is where Chrome on Android stops showing it.'|t('schedulr'),
        id: 'title',
        name: 'title',
        value: notification.title,
        maxlength: 120,
        showCharsLeft: true,
        required: true,
        errors: notification.getErrors('title'),
    }) }}

    {{ forms.textareaField({
        label: 'Body'|t('schedulr'),
        id: 'body',
        name: 'body',
        value: notification.body,
        maxlength: 400,
        showCharsLeft: true,
        rows: 3,
        errors: notification.getErrors('body'),
    }) }}

    {{ forms.textField({
        label: 'Link'|t('schedulr'),
        instructions: 'Where a tap lands. Relative paths resolve against the site.'|t('schedulr'),
        id: 'url',
        name: 'url',
        value: notification.url,
        errors: notification.getErrors('url'),
    }) }}

    <hr>

    {{ forms.checkboxSelectField({
        label: 'Channels'|t('schedulr'),
        instructions: 'The notification is written once and delivered over each channel you enable. Somebody reachable on two channels gets it twice unless you set a delivery policy below.'|t('schedulr'),
        id: 'channels',
        name: 'channels',
        options: channelOptions,
        values: notification.getChannels(),
        required: true,
        errors: notification.getErrors('channels'),
    }) }}

    {% if isPro %}
        {{ forms.selectField({
            label: 'When two channels reach the same person'|t('schedulr'),
            id: 'dedupePolicy',
            name: 'dedupePolicy',
            options: dedupeOptions,
            value: notification.dedupePolicy,
            errors: notification.getErrors('dedupePolicy'),
        }) }}
    {% endif %}

    {{ forms.selectField({
        label: 'Audience'|t('schedulr'),
        id: 'audienceId',
        name: 'audienceId',
        options: [{ label: 'Everyone reachable'|t('schedulr'), value: '' }]|merge(
            audiences|map(a => {
                label: '{name} ({size})'|t('schedulr', { name: a.name, size: a.getCountLabel() }),
                value: a.id,
            })|values
        ),
        value: notification.audienceId,
        disabled: not isPro and audiences|length == 0,
        warning: not isPro ? 'Saved audiences need Schedulr Pro. Topics below work in every edition.'|t('schedulr') : null,
        errors: notification.getErrors('audienceId'),
    }) }}

    {{ forms.textField({
        label: 'Topics'|t('schedulr'),
        instructions: 'Comma separated. Only subscribers tagged with one of these receive it. Leave empty for everybody in the audience.'|t('schedulr'),
        id: 'topics',
        name: 'topics',
        value: notification.getTopics()|join(', '),
        errors: notification.getErrors('topics'),
    }) }}

    {#
      The audience count is the most useful thing on this screen: "4,812 people" beside the send
      button is what turns a send from a leap into a decision.
    #}
    <div class="flex">
        {{ forms.button({ id: 'preview-audience', label: 'Count recipients'|t('schedulr'), spinner: true }) }}
        <span id="audience-count" class="light" role="status" aria-live="polite"></span>
    </div>

    <hr>

    <h2>{{ 'Schedule'|t('schedulr') }}</h2>

    {{ forms.lightswitchField({
        label: 'Schedule is live'|t('schedulr'),
        instructions: 'Off keeps this a draft. A draft never sends, whatever its schedule says.'|t('schedulr'),
        id: 'enabled',
        name: 'enabled',
        on: notification.state != 'draft',
    }) }}

    {{ forms.selectField({
        label: 'Send'|t('schedulr'),
        id: 'mode',
        name: 'mode',
        options: modeOptions,
        value: schedule.mode,
        toggle: true,
        targetPrefix: 'mode-',
    }) }}

    <div id="mode-at" class="{{ schedule.mode == 'at' ? '' : 'hidden' }}">
        {{ forms.dateTimeField({
            label: 'Date and time'|t('schedulr'),
            id: 'sendAt',
            name: 'sendAt',
            value: schedule.sendAt,
            errors: schedule.getErrors('sendAt'),
        }) }}
    </div>

    <div id="mode-recurring" class="{{ schedule.mode == 'recurring' ? '' : 'hidden' }}">
        {{ forms.selectField({
            label: 'How often'|t('schedulr'),
            id: 'frequency',
            name: 'frequency',
            options: [{ label: 'Choose…'|t('schedulr'), value: '' }]|merge(
                frequencyOptions|keys|map(k => { label: frequencyOptions[k], value: k })|values
            ),
            value: schedule.frequency,
            toggle: true,
            targetPrefix: 'freq-',
            errors: schedule.getErrors('frequency'),
        }) }}

        {{ forms.textField({
            label: 'Every'|t('schedulr'),
            instructions: '2 means every other one.'|t('schedulr'),
            id: 'interval',
            name: 'interval',
            value: schedule.interval,
            size: 4,
            type: 'number',
            min: 1,
            max: 365,
            errors: schedule.getErrors('interval'),
        }) }}

        <div id="freq-weekly" class="{{ schedule.frequency == 'weekly' ? '' : 'hidden' }}">
            {{ forms.checkboxSelectField({
                label: 'On these days'|t('schedulr'),
                id: 'byWeekday',
                name: 'byWeekday',
                options: weekdays|keys|map(i => { label: weekdays[i], value: i })|values,
                values: schedule.getByWeekday(),
                errors: schedule.getErrors('byWeekday'),
            }) }}
        </div>

        <div id="freq-monthly" class="{{ schedule.frequency == 'monthly' ? '' : 'hidden' }}">
            {{ forms.textField({
                label: 'On these days of the month'|t('schedulr'),
                instructions: 'Comma separated. Use -1 for the last day, because “31” silently skips February.'|t('schedulr'),
                id: 'byMonthDay',
                name: 'byMonthDay',
                value: schedule.getByMonthDay()|join(', '),
                errors: schedule.getErrors('byMonthDay'),
            }) }}
        </div>

        {{ forms.textField({
            label: 'At'|t('schedulr'),
            id: 'timeOfDay',
            name: 'timeOfDay',
            instructions: '24-hour {format}.'|t('schedulr', { format: '`HH:MM`' }),
            value: schedule.timeOfDay ?? '09:00',
            placeholder: '09:00',
            size: 6,
            errors: schedule.getErrors('timeOfDay'),
        }) }}

        {{ forms.dateField({
            label: 'Start'|t('schedulr'),
            id: 'startDate',
            name: 'startDate',
            value: schedule.startDate,
            errors: schedule.getErrors('startDate'),
        }) }}

        {{ forms.dateField({
            label: 'End'|t('schedulr'),
            id: 'endDate',
            name: 'endDate',
            value: schedule.endDate,
            errors: schedule.getErrors('endDate'),
        }) }}

        {{ forms.textField({
            label: 'Stop after'|t('schedulr'),
            instructions: 'Sends. Leave empty for no limit.'|t('schedulr'),
            id: 'maxOccurrences',
            name: 'maxOccurrences',
            value: schedule.maxOccurrences,
            size: 5,
            type: 'number',
            min: 1,
            errors: schedule.getErrors('maxOccurrences'),
        }) }}

        {{ forms.textareaField({
            label: 'Skip these dates'|t('schedulr'),
            instructions: 'One YYYY-MM-DD per line. Holidays, a launch week.'|t('schedulr'),
            id: 'exclusions',
            name: 'exclusions',
            value: schedule.getExclusions()|join("\n"),
            rows: 3,
            class: 'code',
            errors: schedule.getErrors('exclusions'),
        }) }}
    </div>

    <div id="mode-trigger" class="{{ schedule.mode == 'trigger' ? '' : 'hidden' }}">
        {% if isPro %}
            {{ forms.selectField({
                label: 'Trigger'|t('schedulr'),
                instructions: 'This notification becomes a template. Each firing produces its own notification, with its own record of who it reached, so “which article did we push on Tuesday” has an answer.'|t('schedulr'),
                id: 'triggerType',
                name: 'triggerType',
                options: [{ label: 'Choose…'|t('schedulr'), value: '' }]|merge(
                    triggerOptions|keys|map(k => { label: triggerOptions[k], value: k })|values
                ),
                value: notification.triggerType,
                errors: notification.getErrors('triggerType'),
            }) }}

            <div data-trigger-pane="entry.published" class="{{ notification.triggerType == 'entry.published' ? '' : 'hidden' }}">
                {{ forms.checkboxSelectField({
                    label: 'In these sections'|t('schedulr'),
                    instructions: 'None chosen means every section.'|t('schedulr'),
                    id: 'triggerSectionIds',
                    name: 'triggerSectionIds',
                    options: sections|map(s => { label: s.name, value: s.id })|values,
                    values: notification.getTriggerConfig().sectionIds ?? [],
                }) }}

                {{ forms.lightswitchField({
                    label: 'Send on every save, not just the first publish'|t('schedulr'),
                    instructions: 'Off is almost always right. On means an editor fixing a typo re-notifies everybody.'|t('schedulr'),
                    id: 'triggerEverySave',
                    name: 'triggerEverySave',
                    on: notification.getTriggerConfig().everySave ?? false,
                }) }}

                <p class="light">
                    {{ 'The title, body and link may use Twig against the entry, for example {example}.'|t('schedulr', {
                        example: '<code>{{ entry.title }}</code>'
                    })|raw }}
                </p>
            </div>

            <div data-trigger-pane="user.registered" class="{{ notification.triggerType == 'user.registered' ? '' : 'hidden' }}">
                {{ forms.checkboxSelectField({
                    label: 'In these groups'|t('schedulr'),
                    id: 'triggerGroupIds',
                    name: 'triggerGroupIds',
                    options: userGroups|map(g => { label: g.name, value: g.id })|values,
                    values: notification.getTriggerConfig().groupIds ?? [],
                }) }}
            </div>

            <div data-trigger-pane="inactivity" class="{{ notification.triggerType == 'inactivity' ? '' : 'hidden' }}">
                {{ forms.textField({
                    label: 'Days without a visit'|t('schedulr'),
                    id: 'triggerDays',
                    name: 'triggerDays',
                    value: notification.getTriggerConfig().days ?? 30,
                    size: 5,
                    type: 'number',
                    min: 1,
                    tip: 'Each person receives this once, ever.'|t('schedulr'),
                }) }}
            </div>
        {% else %}
            <blockquote class="note warning">
                <p>{{ 'Automations need Schedulr Pro.'|t('schedulr') }}</p>
            </blockquote>
        {% endif %}
    </div>

    {% if isPro and schedule.mode in ['at', 'recurring'] or schedule.timezoneMode == 'subscriber' %}
        {{ forms.selectField({
            label: 'Time zone'|t('schedulr'),
            instructions: 'The second option turns one send into one per time zone on your list, each at that local time. Check the subscriber screen to see how many that is.'|t('schedulr'),
            id: 'timezoneMode',
            name: 'timezoneMode',
            options: timezoneModeOptions,
            value: schedule.timezoneMode,
            disabled: not isPro,
            warning: not isPro ? 'Requires Schedulr Pro.'|t('schedulr') : null,
            errors: schedule.getErrors('timezoneMode'),
        }) }}
    {% endif %}

    {% if upcoming|length %}
        <h3>{{ 'Next sends'|t('schedulr') }}</h3>
        <table class="data fullwidth">
            <thead>
                <tr>
                    <th scope="col">{{ 'Due'|t('schedulr') }}</th>
                    <th scope="col">{{ 'Time zone'|t('schedulr') }}</th>
                    <th scope="col">{{ 'Status'|t('schedulr') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for occurrence in upcoming %}
                    <tr>
                        <td>{{ occurrence.dueAt|datetime('short') }}</td>
                        <td class="light">{{ occurrence.timezone ?? 'Site time'|t('schedulr') }}</td>
                        <td class="light">{{ occurrence.getStatusLabel() }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    <hr>

    <h2>{{ 'Appearance'|t('schedulr') }}</h2>

    {{ forms.textField({ label: 'Icon URL'|t('schedulr'), id: 'iconUrl', name: 'iconUrl', value: notification.iconUrl, errors: notification.getErrors('iconUrl') }) }}
    {{ forms.textField({ label: 'Badge URL'|t('schedulr'), instructions: 'Monochrome, for the Android status bar.'|t('schedulr'), id: 'badgeUrl', name: 'badgeUrl', value: notification.badgeUrl, errors: notification.getErrors('badgeUrl') }) }}
    {{ forms.textField({ label: 'Image URL'|t('schedulr'), id: 'imageUrl', name: 'imageUrl', value: notification.imageUrl, errors: notification.getErrors('imageUrl') }) }}

    {{ forms.textField({
        label: 'Collapse key'|t('schedulr'),
        instructions: 'Two notifications sharing a key replace each other on the device. Worth setting for anything that supersedes itself, such as a score or a status. Worth leaving empty for anything that does not, or today’s second article eats the first.'|t('schedulr'),
        id: 'tag',
        name: 'tag',
        value: notification.tag,
        errors: notification.getErrors('tag'),
    }) }}

    {{ forms.lightswitchField({
        label: 'Keep on screen until acted on'|t('schedulr'),
        instructions: 'Ignored by most mobile browsers.'|t('schedulr'),
        id: 'requireInteraction',
        name: 'requireInteraction',
        on: notification.requireInteraction,
    }) }}

    {#
      Posted as buttons[<row>][title] and buttons[<row>][url]. The controller reads the rows by value,
      not by key, so Craft's "new1"-style keys for added rows are fine.
    #}
    {{ forms.editableTableField({
        label: 'Action buttons'|t('schedulr'),
        instructions: 'Two at most. Every browser that supports them shows two, and a third is invisible with no warning.'|t('schedulr'),
        id: 'buttons',
        name: 'buttons',
        cols: {
            title: { heading: 'Label'|t('schedulr'), type: 'singleline' },
            url: { heading: 'Link'|t('schedulr'), type: 'url', placeholder: 'https://…' },
        },
        rows: notification.getButtons(),
        addRowLabel: 'Add a button'|t('schedulr'),
        allowAdd: true,
        allowDelete: true,
        allowReorder: true,
        maxRows: 2,
        errors: notification.getErrors('buttons'),
    }) }}

    {% if 'email' in notification.getChannels() or notification.emailSubject %}
        <hr>
        <h2>{{ 'Email'|t('schedulr') }}</h2>
        <p class="light">
            {{ 'A 120-character push title is a poor subject line and a 400-character body is a poor email. Leave these empty to reuse the push copy.'|t('schedulr') }}
        </p>

        {{ forms.textField({ label: 'Subject'|t('schedulr'), id: 'emailSubject', name: 'emailSubject', value: notification.emailSubject, errors: notification.getErrors('emailSubject') }) }}
        {{ forms.textareaField({ label: 'HTML body'|t('schedulr'), id: 'emailBody', name: 'emailBody', value: notification.emailBody, rows: 8, class: 'code', errors: notification.getErrors('emailBody') }) }}
    {% endif %}

    {% if isPro %}
        <hr>
        <h2>{{ 'A/B test'|t('schedulr') }}</h2>
        <p class="light">
            {{ 'Fill in a second variant to split the audience. Each person is always put in the same arm, so a retried batch never shows one person both.'|t('schedulr') }}
            {{ 'Fields left empty inherit from above.'|t('schedulr') }}
        </p>

        {% for i in 0..1 %}
            {% set variant = variants[i] ?? null %}
            {% set arm = i == 0 ? 'A' : 'B' %}
            <h3>{{ 'Variant {label}'|t('schedulr', { label: arm }) }}</h3>
            {{ hiddenInput('variants[' ~ i ~ '][label]', arm) }}
            {% if variant %}{{ hiddenInput('variants[' ~ i ~ '][id]', variant.id) }}{% endif %}

            {{ forms.textField({ label: 'Title'|t('app'), id: 'variant-' ~ i ~ '-title', name: 'variants[' ~ i ~ '][title]', value: variant.title ?? '', maxlength: 120 }) }}
            {{ forms.textareaField({ label: 'Body'|t('schedulr'), id: 'variant-' ~ i ~ '-body', name: 'variants[' ~ i ~ '][body]', value: variant.body ?? '', rows: 2 }) }}
            {{ forms.textField({ label: 'Link'|t('schedulr'), id: 'variant-' ~ i ~ '-url', name: 'variants[' ~ i ~ '][url]', value: variant.url ?? '' }) }}
            {{ forms.textField({ label: 'Share of audience (%)'|t('schedulr'), id: 'variant-' ~ i ~ '-share', name: 'variants[' ~ i ~ '][share]', value: variant.share ?? 50, size: 4, type: 'number', min: 1, max: 100 }) }}

            {% if variant and variant.delivered %}
                <p class="light">
                    {% set rate = variant.getClickRate() %}
                    {% if rate is not null %}
                        {{ '{delivered} delivered, {clicked} clicked ({rate}%)'|t('schedulr', { delivered: variant.delivered|number_format, clicked: variant.clicked|number_format, rate: rate }) }}
                    {% else %}
                        {{ '{delivered} delivered, {clicked} clicked'|t('schedulr', { delivered: variant.delivered|number_format, clicked: variant.clicked|number_format }) }}
                    {% endif %}
                    {% if variant.isWinner %}<strong>{{ 'The winner.'|t('schedulr') }}</strong>{% endif %}
                </p>
            {% endif %}
        {% endfor %}
    {% endif %}

    {% if funnel|length %}
        <hr>
        <h2>{{ 'Results'|t('schedulr') }}</h2>
        {% set funnelLabels = {
            targeted: 'Targeted'|t('schedulr'),
            delivered: 'Delivered'|t('schedulr'),
            failed: 'Failed'|t('schedulr'),
            displayed: 'Shown'|t('schedulr'),
            clicked: 'Clicked'|t('schedulr'),
            dismissed: 'Dismissed'|t('schedulr'),
            clicks: 'Total clicks'|t('schedulr'),
            deliveryRate: 'Delivery rate'|t('schedulr'),
            clickRate: 'Click rate'|t('schedulr'),
            dismissRate: 'Dismiss rate'|t('schedulr'),
        } %}
        <table class="data fullwidth">
            <tbody>
                {% for key, value in funnel %}
                    <tr>
                        <th scope="row">{{ funnelLabels[key] ?? key }}</th>
                        <td>
                            {% if value is null %}
                                {{ ui.muted('Not enough data'|t('schedulr')) }}
                            {% elseif key ends with 'Rate' %}
                                {{ value }}%
                            {% else %}
                                {{ value|number_format }}
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        <p><a class="go" href="{{ url('schedulr/notifications/' ~ notification.id ~ '/deliveries') }}">{{ 'Full delivery log'|t('schedulr') }}</a></p>
    {% endif %}

    {% do view.registerTranslations('schedulr', ['Counting…', 'Could not count.']) %}

    {% js %}
        // Craft's own select toggle builds its target selector as '#' + prefix + value, so a value
        // containing a dot (entry.published) is parsed by jQuery as an id plus a class and nothing
        // ever toggles. Done by hand for that one field.
        function schedulrTriggerPanes() {
            var value = $('#triggerType').val();
            $('[data-trigger-pane]').each(function() {
                $(this).toggleClass('hidden', $(this).data('trigger-pane') !== value);
            });
        }

        $('#triggerType').on('change', schedulrTriggerPanes);
        schedulrTriggerPanes();

        $('#preview-audience').on('click', function() {
            var $button = $(this).addClass('loading').attr('aria-busy', 'true');
            var $out = $('#audience-count').text(Craft.t('schedulr', 'Counting…'));

            Craft.sendActionRequest('POST', 'schedulr/notifications/preview-audience', {
                data: {
                    siteId: $('#siteId').val(),
                    audienceId: $('#audienceId').val(),
                    topics: $('#topics').val(),
                    channels: $('input[name="channels[]"]:checked').map(function() { return this.value; }).get()
                }
            }).then(function(response) {
                $out.text(response.data.label);
            }).catch(function() {
                $out.text(Craft.t('schedulr', 'Could not count.'));
            }).then(function() {
                $button.removeClass('loading').removeAttr('aria-busy');
            });
        });
    {% endjs %}
{% endblock %}

{% extends 'schedulr/settings/_layout' %}
{% import '_includes/forms' as forms %}

{% block pane %}
    <p class="light">
        {#
          Two things the email channel deliberately does not do, stated here because both look like
          missing features until you know why.
        #}
        {{ 'One email per recipient, never a Bcc list — a Bcc list discloses your subscribers to each other the first time somebody replies to all, and a per-person unsubscribe link is not optional for a bulk sender.'|t('schedulr') }}
    </p>

    {{ forms.textField({
        label: 'From name'|t('schedulr'),
        instructions: 'Empty uses the system setting.'|t('schedulr'),
        name: 'settings[emailFromName]',
        value: settings.emailFromName,
    }) }}

    {{ forms.textField({
        label: 'From address'|t('schedulr'),
        instructions: 'Empty uses the system setting.'|t('schedulr'),
        name: 'settings[emailFromEmail]',
        value: settings.emailFromEmail,
    }) }}

    {{ forms.textField({
        label: 'Template'|t('schedulr'),
        instructions: 'A site template rendered for each email. Empty uses Schedulr’s bundled one, which is deliberately plain — a bundled template that tries to be a designed email is one every site has to override.'|t('schedulr'),
        name: 'settings[emailTemplate]',
        value: settings.emailTemplate,
        placeholder: '_emails/notification',
    }) }}

    <div class="readable" style="margin-top: 20px;">
        <h2>{{ 'What the template receives'|t('schedulr') }}</h2>
        <table class="data fullwidth">
            <tbody>
                {% for name, description in {
                    'notification': 'The notification element.'|t('schedulr'),
                    'subscriber': 'Who it is going to.'|t('schedulr'),
                    'title': 'The title, with any A/B variant already applied.'|t('schedulr'),
                    'body': 'The HTML body, already marked safe.'|t('schedulr'),
                    'url': 'The tracked link. Use this rather than notification.url, or clicks go uncounted.'|t('schedulr'),
                    'unsubscribeUrl': 'A signed, per-person unsubscribe link. Your template must include it.'|t('schedulr'),
                    'siteName': 'The current site’s name.'|t('schedulr'),
                } %}
                    <tr>
                        <th style="width: 180px;"><code>{{ name }}</code></th>
                        <td>{{ description }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        <p class="light">
            {{ 'Schedulr also sets the {header} headers, so Gmail and Outlook show a one-click unsubscribe — a bulk sender without them is a bulk sender in the spam folder.'|t('schedulr', {
                header: '<code>List-Unsubscribe</code>'
            })|raw }}
        </p>
    </div>
{% endblock %}

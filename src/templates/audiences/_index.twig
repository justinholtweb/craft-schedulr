{% extends 'schedulr/_layouts/cp' %}

{% set selectedSubnavItem = 'audiences' %}

{% block actionButton %}
    {% if canCreate %}
        <a href="{{ url('schedulr/audiences/new') }}" class="btn submit add icon">{{ 'New audience'|t('schedulr') }}</a>
    {% endif %}
{% endblock %}

{% block content %}
    {% if not isPro %}
        <blockquote class="note warning schedulr-banner">
            <p>
                <strong>{{ 'Audiences need Schedulr Pro.'|t('schedulr') }}</strong>
                {# Stated so nobody discovers it by a campaign silently reaching nobody. #}
                {{ 'Any audiences already saved keep working and keep being sent to. Lite only stops new ones being created.'|t('schedulr') }}
            </p>
        </blockquote>
        {% css %}
            .schedulr-banner { margin-block: 0 var(--xl); }
        {% endcss %}
    {% endif %}

    {% if audiences|length %}
        <table class="data fullwidth">
            <thead>
                <tr>
                    <th scope="col">{{ 'Name'|t('app') }}</th>
                    <th scope="col">{{ 'Handle'|t('app') }}</th>
                    <th scope="col">{{ 'Rules'|t('schedulr') }}</th>
                    <th scope="col">{{ 'Size'|t('schedulr') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for audience in audiences %}
                    <tr>
                        <td><a href="{{ url('schedulr/audiences/' ~ audience.id) }}">{{ audience.name }}</a></td>
                        <td><code>{{ audience.handle }}</code></td>
                        <td>{{ audience.getRuleCount() }}</td>
                        {# The count carries its own timestamp. A number with no provenance is a number
                           nobody can act on. #}
                        <td class="light">{{ audience.getCountLabel() }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p class="zilch small">
            {{ 'No audiences yet. Without one, a notification goes to everybody reachable on its channels, which is often exactly right.'|t('schedulr') }}
        </p>
    {% endif %}
{% endblock %}

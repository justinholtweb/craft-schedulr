{% extends 'schedulr/_layouts/cp' %}
{% import '_includes/forms' as forms %}

{% set fullPageForm = true %}
{% set selectedSubnavItem = 'audiences' %}
{% set crumbs = [
    { label: 'Schedulr'|t('schedulr'), url: url('schedulr') },
    { label: 'Audiences'|t('schedulr'), url: url('schedulr/audiences') },
] %}

{% block content %}
    {{ actionInput('schedulr/audiences/save') }}
    {{ redirectInput('schedulr/audiences/{id}') }}
    {% if audience.id %}{{ hiddenInput('audienceId', audience.id) }}{% endif %}

    {{ forms.textField({
        first: true,
        label: 'Name'|t('app'),
        id: 'name',
        name: 'name',
        value: audience.name,
        required: true,
        errors: audience.getErrors('name'),
    }) }}

    {{ forms.textField({
        label: 'Handle'|t('app'),
        instructions: 'Used by {code} on the console.'|t('schedulr', { code: '<code>--audience</code>' }),
        id: 'handle',
        name: 'handle',
        value: audience.handle,
        errors: audience.getErrors('handle'),
    }) }}

    {{ forms.textareaField({
        label: 'Description'|t('app'),
        id: 'description',
        name: 'description',
        value: audience.description,
        rows: 2,
        errors: audience.getErrors('description'),
    }) }}

    {{ forms.selectField({
        label: 'Sites'|t('app'),
        id: 'siteId',
        name: 'siteId',
        options: [{ label: 'Every site'|t('schedulr'), value: '' }]|merge(
            sites|map(s => { label: s.name, value: s.id })|values
        ),
        value: audience.siteId,
        errors: audience.getErrors('siteId'),
    }) }}

    <hr>

    {{ forms.selectField({
        label: 'Match'|t('schedulr'),
        id: 'match',
        name: 'match',
        options: [
            { label: 'All of these rules'|t('schedulr'), value: 'all' },
            { label: 'Any of these rules'|t('schedulr'), value: 'any' },
        ],
        value: audience.getCondition().match,
    }) }}

    {#
      Every rule compiles to SQL over one table, which is why the count is instant and why the count
      exists at all. A segment whose size is discovered at send time is discovered too late.
    #}
    {{ forms.field({
        label: 'Rules'|t('schedulr'),
        instructions: 'Counting runs the rules against the whole list. It is a single query, so it is safe to press often.'|t('schedulr'),
        id: 'rules',
        fieldset: true,
        errors: audience.getErrors('rules') ?? [],
    }, '<div id="rules" class="schedulr-rules"></div>') }}

    <div class="flex">
        <button type="button" class="btn dashed add icon" id="add-rule">{{ 'Add a rule'|t('schedulr') }}</button>
        {{ forms.button({ id: 'preview', label: 'Count'|t('schedulr'), spinner: true }) }}
        <span id="count" class="light" role="status" aria-live="polite"></span>
    </div>

    {% do view.registerTranslations('schedulr', [
        'days',
        'Rule {n}',
        'Rule type',
        'Condition',
        'Value',
        'Remove rule {n}',
        'Counting…',
        'Could not count.',
    ]) %}
    {% do view.registerTranslations('app', ['Yes', 'No']) %}

    {% css %}
        .schedulr-rules { display: flex; flex-direction: column; gap: var(--s); }
        .schedulr-rule { display: flex; flex-wrap: wrap; align-items: flex-start; gap: var(--s); }
        .schedulr-rule .text[type=number] { inline-size: 6rem; }
        .schedulr-rule-suffix { align-self: center; }
    {% endcss %}

    {% js %}
        var RULE_TYPES = {{ ruleTypes|json_encode|raw }};
        var OPERATORS = {{ operatorLabels|json_encode|raw }};
        var CHOICES = {
            timezones: {{ timezones|json_encode|raw }},
            platforms: {{ platforms|json_encode|raw }},
            tags: {{ tags|json_encode|raw }},
            userGroups: {{ userGroups|map(g => { label: g.name, value: g.id })|values|json_encode|raw }},
            sites: {{ sites|map(s => { label: s.name, value: s.id })|values|json_encode|raw }},
            notifications: {{ notifications|map(n => { label: n.title, value: n.id })|values|json_encode|raw }}
        };
        var EXISTING = {{ audience.getCondition().rules|json_encode|raw }};

        var index = 0;

        function esc(value) {
            return Craft.escapeHtml(String(value));
        }

        function optionsHtml(list, selected) {
            return list.map(function(item) {
                var value = typeof item === 'object' ? item.value : item;
                var label = typeof item === 'object' ? item.label : item;
                var isSelected = String(selected) === String(value) ||
                    (Array.isArray(selected) && selected.map(String).indexOf(String(value)) !== -1);
                return '<option value="' + esc(value) + '"' + (isSelected ? ' selected' : '') + '>' + esc(label) + '</option>';
            }).join('');
        }

        // Grouped into optgroups by the type's `group`, so the menu reads "Reachability" once rather than
        // prefixing every option with it.
        function typeOptionsHtml(selected) {
            var groups = {};
            var order = [];
            Object.keys(RULE_TYPES).forEach(function(key) {
                var group = RULE_TYPES[key].group || '';
                if (!groups[group]) { groups[group] = []; order.push(group); }
                groups[group].push('<option value="' + esc(key) + '"' + (key === selected ? ' selected' : '') + '>' +
                    esc(RULE_TYPES[key].label) + '</option>');
            });
            return order.map(function(group) {
                return '<optgroup label="' + esc(group) + '">' + groups[group].join('') + '</optgroup>';
            }).join('');
        }

        function operatorOptionsHtml(spec, selected) {
            return (spec.operators || ['eq']).map(function(op) {
                return '<option value="' + esc(op) + '"' + (op === selected ? ' selected' : '') + '>' + esc(OPERATORS[op] || op) + '</option>';
            }).join('');
        }

        // Every control carries its own accessible name, because a row of three bare selects reads as
        // "combo box, combo box, combo box" otherwise. Native selects sit inside Craft's `.select`
        // wrapper (and multi-selects inside `.multiselect`), which is what gives them CP chrome.
        function valueInput(i, n, type, value) {
            var spec = RULE_TYPES[type] || {};
            var name = 'rules[' + i + '][value]';
            var label = esc(Craft.t('schedulr', 'Value') + ' (' + Craft.t('schedulr', 'Rule {n}', { n: n }) + ')');

            switch (spec.input) {
                case 'boolean':
                    return '<div class="select"><select name="' + name + '" aria-label="' + label + '">' +
                        optionsHtml([{ label: Craft.t('app', 'Yes'), value: '1' }, { label: Craft.t('app', 'No'), value: '' }], value) +
                        '</select></div>';
                case 'number':
                case 'days':
                    // The days input is a duration, never a date. A segment saved with an absolute date
                    // silently stops matching anybody a month later.
                    return '<input type="number" min="0" class="text" name="' + name + '" aria-label="' + label + '" value="' +
                        esc(value || '') + '">' +
                        (spec.input === 'days' ? '<span class="light schedulr-rule-suffix">' + esc(Craft.t('schedulr', 'days')) + '</span>' : '');
                case 'timezones':
                case 'platforms':
                case 'tags':
                case 'userGroups':
                case 'sites':
                case 'notifications':
                    return '<div class="multiselect"><select name="' + name + '[]" multiple size="4" aria-label="' + label + '">' +
                        optionsHtml(CHOICES[spec.input] || [], value) + '</select></div>';
                default:
                    return '<input type="text" class="text" name="' + name + '" aria-label="' + label + '" value="' +
                        esc(value || '') + '">';
            }
        }

        function renumber() {
            $('#rules').children().each(function(position) {
                var n = position + 1;
                var $row = $(this);
                $row.attr('aria-label', Craft.t('schedulr', 'Rule {n}', { n: n }));
                $row.find('[data-role="type"]').attr('aria-label', Craft.t('schedulr', 'Rule type') + ' (' + Craft.t('schedulr', 'Rule {n}', { n: n }) + ')');
                $row.find('[data-role="operator"]').attr('aria-label', Craft.t('schedulr', 'Condition') + ' (' + Craft.t('schedulr', 'Rule {n}', { n: n }) + ')');
                $row.find('[data-role="value"]').find('select, input').attr('aria-label', Craft.t('schedulr', 'Value') + ' (' + Craft.t('schedulr', 'Rule {n}', { n: n }) + ')');
                $row.find('[data-role="remove"]').attr('aria-label', Craft.t('schedulr', 'Remove rule {n}', { n: n }))
                    .attr('title', Craft.t('schedulr', 'Remove rule {n}', { n: n }));
            });
        }

        function addRule(rule) {
            var i = index++;
            var type = (rule && rule.type) || Object.keys(RULE_TYPES)[0];
            var spec = RULE_TYPES[type] || {};

            var $row = $(
                '<div class="schedulr-rule" role="group">' +
                    '<div class="select"><select name="rules[' + i + '][type]" data-role="type">' + typeOptionsHtml(type) + '</select></div>' +
                    '<div class="select"><select name="rules[' + i + '][operator]" data-role="operator">' + operatorOptionsHtml(spec, rule ? rule.operator : null) + '</select></div>' +
                    '<span class="flex" data-role="value">' + valueInput(i, 0, type, rule ? rule.value : null) + '</span>' +
                    '<button type="button" class="btn" data-icon="remove" data-role="remove"></button>' +
                '</div>'
            );

            // Rebuilt on change rather than adapted, because the operator list and the value input both
            // depend on the type, and half-updating them is how a rule ends up with an operator its type
            // does not compile.
            $row.on('change', '[data-role="type"]', function() {
                var newType = $(this).val();
                var newSpec = RULE_TYPES[newType] || {};

                $row.find('[data-role="operator"]').html(operatorOptionsHtml(newSpec, null));
                $row.find('[data-role="value"]').html(valueInput(i, 0, newType, null));
                renumber();
            });

            $row.on('click', '[data-role="remove"]', function() {
                var $next = $row.next().length ? $row.next() : $row.prev();
                $row.remove();
                renumber();
                ($next.length ? $next.find('[data-role="remove"]') : $('#add-rule')).trigger('focus');
            });

            $('#rules').append($row);
            renumber();

            return $row;
        }

        $('#add-rule').on('click', function() {
            addRule(null).find('[data-role="type"]').trigger('focus');
        });

        (EXISTING || []).forEach(addRule);

        if (!EXISTING || !EXISTING.length) {
            addRule({ type: 'pushable', operator: 'eq', value: '1' });
        }

        $('#preview').on('click', function() {
            var $button = $(this);
            var $out = $('#count').text(Craft.t('schedulr', 'Counting…'));

            // Built field by field rather than by serialising the form, and the reason is not tidiness:
            // the page form carries the save action, and Craft resolves the action from the body param
            // before the URL, so posting the whole form to the preview endpoint would run the save
            // instead. Same family of trap as two action inputs in one form.
            var params = new URLSearchParams();
            params.append('match', $('#match').val());
            params.append('siteId', $('#siteId').val() || '');

            $('#rules').children().each(function(i) {
                var $row = $(this);
                params.append('rules[' + i + '][type]', $row.find('[data-role="type"]').val());
                params.append('rules[' + i + '][operator]', $row.find('[data-role="operator"]').val());

                var $value = $row.find('[data-role="value"]').find('select, input');

                if ($value.is('select[multiple]')) {
                    ($value.val() || []).forEach(function(v) {
                        params.append('rules[' + i + '][value][]', v);
                    });
                } else {
                    params.append('rules[' + i + '][value]', $value.val() || '');
                }
            });

            $button.addClass('loading').attr('aria-busy', 'true');

            Craft.sendActionRequest('POST', 'schedulr/audiences/preview', {
                data: params,
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' }
            }).then(function(response) {
                $out.text(response.data.label);
            }).catch(function() {
                $out.text(Craft.t('schedulr', 'Could not count.'));
            }).then(function() {
                $button.removeClass('loading').removeAttr('aria-busy');
            });
        });
    {% endjs %}
{% endblock %}

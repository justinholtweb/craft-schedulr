{#
  The page an email's unsubscribe link lands on.

  Rendered in CP template mode from the plugin's own directory so it works on a site whose templates
  know nothing about Schedulr — an unsubscribe link that 404s is worse than no link at all, and it is
  the one link a mail provider will test.

  Two states. Arriving by GET (`confirmed` false) shows one button that POSTs back with the signed
  token; nothing is changed until it is pressed, because mail scanners fetch every link in a message.
  No CSRF field: the controller is CSRF-exempt and the signed token is the authentication.
#}
{% set confirmed = confirmed ?? true %}
<!DOCTYPE html>
<html lang="{{ craft.app.language }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ (confirmed ? 'Unsubscribed' : 'Unsubscribe')|t('schedulr') }}</title>
    <style>
        :root { color-scheme: light dark; }
        body {
            font: 16px/1.55 -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
            display: grid; place-items: center; min-height: 100vh; margin: 0;
            background: #fff; color: #17141c;
        }
        @media (prefers-color-scheme: dark) { body { background: #1d1a22; color: #f4f1f7; } }
        .box { max-width: 30rem; padding: 2rem; text-align: center; }
        h1 { font-size: 1.375rem; margin: 0 0 .5rem; }
        p { margin: 0; opacity: .75; }
        form { margin: 1.5rem 0 0; }
        button {
            font: inherit; font-weight: 600; padding: .75rem 1.25rem; border: 0; border-radius: 6px;
            background: #C7278C; color: #fff; cursor: pointer;
        }
    </style>
</head>
<body>
    <div class="box">
        {% if confirmed %}
            <h1>{{ 'You’ve been unsubscribed'|t('schedulr') }}</h1>
            <p>{{ 'You won’t receive any more notifications from {site}.'|t('schedulr', { site: siteName }) }}</p>
        {% else %}
            <h1>{{ 'Unsubscribe from {site}?'|t('schedulr', { site: siteName }) }}</h1>
            <p>{{ 'You’ll stop receiving notifications from {site} by email, push and on the site.'|t('schedulr', { site: siteName }) }}</p>
            <form method="post" action="{{ actionUrl }}">
                <input type="hidden" name="sr_u" value="{{ token }}">
                <button type="submit">{{ 'Unsubscribe'|t('schedulr') }}</button>
            </form>
        {% endif %}
    </div>
</body>
</html>

{% extends 'schedulr/_layouts/cp' %}

{% set selectedSubnavItem = 'notifications' %}
{% set crumbs = [
    { label: 'Schedulr'|t('schedulr'), url: url('schedulr') },
    { label: 'Notifications'|t('schedulr'), url: url('schedulr/notifications') },
    { label: notification.title, url: url('schedulr/notifications/' ~ notification.id) },
] %}

{% block actionButton %}
    <a href="{{ url('schedulr/reports/export', { notificationId: notification.id }) }}" class="btn">
        {{ 'Export CSV'|t('schedulr') }}
    </a>
{% endblock %}

{% block content %}
    {% if funnel|length %}
        <div class="flex" style="gap: 32px; margin-bottom: 24px;">
            {% for key, label in {
                targeted: 'Targeted'|t('schedulr'),
                delivered: 'Delivered'|t('schedulr'),
                failed: 'Failed'|t('schedulr'),
                displayed: 'Shown'|t('schedulr'),
                clicked: 'Clicked'|t('schedulr'),
            } %}
                <div>
                    <div class="light smalltext">{{ label }}</div>
                    <div style="font-size: 20px;">{{ funnel[key]|number_format }}</div>
                </div>
            {% endfor %}
            <div>
                <div class="light smalltext">{{ 'Click rate'|t('schedulr') }}</div>
                {# Null, not zero. "0%" against zero deliveries reads as a campaign that failed rather
                   than one that has not been sent — and it is the number people screenshot. #}
                <div style="font-size: 20px;">{{ funnel.clickRate is null ? '—' : funnel.clickRate ~ '%' }}</div>
            </div>
        </div>
    {% endif %}

    {% if variants|length > 1 %}
        <div class="pane">
            <h2>{{ 'A/B result'|t('schedulr') }}</h2>
            <table class="data fullwidth">
                <thead>
                    <tr>
                        <th>{{ 'Variant'|t('schedulr') }}</th>
                        <th>{{ 'Share'|t('schedulr') }}</th>
                        <th>{{ 'Delivered'|t('schedulr') }}</th>
                        <th>{{ 'Clicked'|t('schedulr') }}</th>
                        <th>{{ 'Click rate'|t('schedulr') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for variant in variants %}
                        <tr>
                            <td>
                                {{ variant.label }}
                                {% if variant.isWinner %}<strong> · {{ 'winner'|t('schedulr') }}</strong>{% endif %}
                            </td>
                            <td>{{ variant.share }}%</td>
                            <td>{{ variant.delivered|number_format }}</td>
                            <td>{{ variant.clicked|number_format }}</td>
                            <td>{{ variant.getClickRate() is null ? '—' : variant.getClickRate() ~ '%' }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            <p class="light smalltext">
                {{ 'A winner is only declared once both arms have at least 100 deliveries.'|t('schedulr') }}
            </p>
        </div>
    {% endif %}

    {% if summary|length %}
        <div class="pane">
            <h2>{{ 'By channel'|t('schedulr') }}</h2>
            <table class="data fullwidth">
                <tbody>
                    {% for channel, statuses in summary %}
                        <tr>
                            <th style="width: 140px;">{{ channel }}</th>
                            <td>
                                {% for status, count in statuses %}
                                    <span class="light">{{ status }}</span> {{ count|number_format }}{{ not loop.last ? ' · ' : '' }}
                                {% endfor %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

    {% if failures|length %}
        <div class="pane">
            <h2>{{ 'Why things failed'|t('schedulr') }}</h2>
            {# Grouped by status code, not by message: a push service's body text varies per request
               while its code does not, so grouping on the message gives four hundred groups of one. #}
            <table class="data fullwidth">
                <thead>
                    <tr>
                        <th>{{ 'Channel'|t('schedulr') }}</th>
                        <th>{{ 'Outcome'|t('schedulr') }}</th>
                        <th>{{ 'Code'|t('schedulr') }}</th>
                        <th>{{ 'Count'|t('schedulr') }}</th>
                        <th>{{ 'Example'|t('schedulr') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in failures %}
                        <tr>
                            <td>{{ row.channel }}</td>
                            <td>{{ row.status }}</td>
                            <td>{{ row.statusCode ?? '—' }}</td>
                            <td>{{ row.total|number_format }}</td>
                            <td class="light smalltext">{{ row.example ? row.example|slice(0, 140) : '' }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}

    <div class="pane">
        <div class="flex" style="justify-content: space-between; align-items: center;">
            <h2 style="margin: 0;">{{ 'Delivery log'|t('schedulr') }}</h2>
            <a class="btn{{ failedOnly ? ' active' : '' }}"
               href="{{ url('schedulr/notifications/' ~ notification.id ~ '/deliveries', failedOnly ? {} : { failed: 1 }) }}">
                {{ failedOnly ? 'Show all'|t('schedulr') : 'Failures only'|t('schedulr') }}
            </a>
        </div>

        {% if rows|length %}
            <table class="data fullwidth" style="margin-top: 12px;">
                <thead>
                    <tr>
                        <th>{{ 'When'|t('schedulr') }}</th>
                        <th>{{ 'Recipient'|t('schedulr') }}</th>
                        <th>{{ 'Channel'|t('schedulr') }}</th>
                        <th>{{ 'Status'|t('schedulr') }}</th>
                        <th>{{ 'Detail'|t('schedulr') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                        {% set subscriber = row.subscriberId ? subscribers[row.subscriberId] ?? null : null %}
                        <tr>
                            <td class="light">{{ row.dateCreated|datetime('short') }}</td>
                            <td>
                                {% if subscriber %}
                                    <a href="{{ url('schedulr/subscribers/' ~ subscriber.id) }}">
                                        {{ subscriber.getEmailAddress() ?? subscriber.visitorId|slice(0, 8) }}
                                    </a>
                                {% else %}
                                    {# Not an orphan to tidy away — the ledger outliving its subjects is
                                       the point of `ON DELETE SET NULL`. #}
                                    <span class="light">{{ 'forgotten'|t('schedulr') }}</span>
                                {% endif %}
                            </td>
                            <td>{{ row.channel }}</td>
                            <td>{{ row.status }}{% if row.statusCode %} <span class="light">{{ row.statusCode }}</span>{% endif %}</td>
                            <td class="light smalltext">{{ row.error ? row.error|slice(0, 140) : '' }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

            {% if pageCount > 1 %}
                <div class="flex" style="margin-top: 16px; align-items: center;">
                    {% if page > 1 %}
                        <a class="btn" href="{{ url('schedulr/notifications/' ~ notification.id ~ '/deliveries', { page: page - 1, failed: failedOnly ? 1 : null }) }}">{{ 'Previous'|t('app') }}</a>
                    {% endif %}
                    <span class="light">{{ 'Page {page} of {total}'|t('schedulr', { page: page, total: pageCount }) }}</span>
                    {% if page < pageCount %}
                        <a class="btn" href="{{ url('schedulr/notifications/' ~ notification.id ~ '/deliveries', { page: page + 1, failed: failedOnly ? 1 : null }) }}">{{ 'Next'|t('app') }}</a>
                    {% endif %}
                </div>
            {% endif %}
        {% else %}
            <p class="light">{{ 'Nothing recorded yet.'|t('schedulr') }}</p>
        {% endif %}
    </div>

    {% if occurrences|length %}
        <div class="pane">
            <h2>{{ 'Sends'|t('schedulr') }}</h2>
            <table class="data fullwidth">
                <thead>
                    <tr>
                        <th>{{ 'Due'|t('schedulr') }}</th>
                        <th>{{ 'Time zone'|t('schedulr') }}</th>
                        <th>{{ 'Status'|t('schedulr') }}</th>
                        <th>{{ 'Targeted'|t('schedulr') }}</th>
                        <th>{{ 'Delivered'|t('schedulr') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for occurrence in occurrences %}
                        <tr>
                            <td>{{ occurrence.dueAt|datetime('short') }}</td>
                            <td class="light">{{ occurrence.timezone ?? '' }}</td>
                            <td>{{ occurrence.getStatusLabel() }}</td>
                            <td>{{ occurrence.targeted }}</td>
                            <td>{{ occurrence.delivered }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}

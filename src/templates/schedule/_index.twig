{% extends 'schedulr/_layouts/cp' %}
{% import '_includes/forms' as forms %}

{% set selectedSubnavItem = 'schedule' %}

{% block actionButton %}
    {% if canSend %}
        {{ forms.button({
            id: 'run-now',
            label: 'Run now'|t('schedulr'),
            spinner: true,
        }) }}
    {% endif %}
{% endblock %}

{% block content %}
    {#
      The banner leads. A beautiful list of sends that nothing will ever act on is precisely the
      failure this whole design is arranged to avoid, so the health of the runner is the first thing
      on the screen, above the list it would otherwise make a liar of.
    #}
    {% include 'schedulr/_components/_runner-banner' %}

    {% set lastRun = health.lastCron ?? health.lastWeb %}

    {% include 'schedulr/_components/_stats' with {
        stats: [
            { label: 'Runner'|t('schedulr'), value: {
                cron: 'Cron'|t('schedulr'),
                web: 'Web requests'|t('schedulr'),
                stalled: 'Stalled'|t('schedulr'),
                manual: 'Off'|t('schedulr'),
            }[health.state] ?? health.state },
            { label: 'Last run'|t('schedulr'), value: lastRun ? lastRun|datetime('short') : 'Never'|t('schedulr') },
            { label: 'Pending'|t('schedulr'), value: health.pending|number_format },
            { label: 'Overdue'|t('schedulr'), value: health.overdue|number_format, tone: health.overdue ? 'error' : null },
        ],
    } only %}

    <h2>{{ 'Coming up'|t('schedulr') }}</h2>

    {% if upcoming|length %}
        <table class="data fullwidth">
            <thead>
                <tr>
                    <th scope="col">{{ 'Due'|t('schedulr') }}</th>
                    <th scope="col">{{ 'Time zone'|t('schedulr') }}</th>
                    <th scope="col">{{ 'Notification'|t('schedulr') }}</th>
                    <th scope="col">{{ 'Status'|t('schedulr') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for occurrence in upcoming %}
                    <tr>
                        <td>{{ occurrence.dueAt|datetime('short') }}</td>
                        {#
                          A site-time send has no zone of its own: it is one moment for everybody, which
                          is the normal case, so it says so in words rather than leaving a gap.
                        #}
                        <td class="light">{{ occurrence.timezone ?? 'Site time'|t('schedulr') }}</td>
                        <td>
                            <a href="{{ url('schedulr/notifications/' ~ occurrence.notificationId) }}">
                                {{ titles[occurrence.notificationId] ?? '(deleted)'|t('schedulr') }}
                            </a>
                        </td>
                        <td class="light">{{ occurrence.getStatusLabel() }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p class="zilch small">{{ 'Nothing is scheduled.'|t('schedulr') }}</p>
    {% endif %}

    <hr>

    <h2>{{ 'Recently'|t('schedulr') }}</h2>

    {% if recent|length %}
        <table class="data fullwidth">
            <thead>
                <tr>
                    <th scope="col">{{ 'Due'|t('schedulr') }}</th>
                    <th scope="col">{{ 'Notification'|t('schedulr') }}</th>
                    <th scope="col">{{ 'Status'|t('schedulr') }}</th>
                    <th scope="col">{{ 'Targeted'|t('schedulr') }}</th>
                    <th scope="col">{{ 'Delivered'|t('schedulr') }}</th>
                    <th scope="col">{{ 'Failed'|t('schedulr') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for occurrence in recent %}
                    <tr>
                        <td>{{ occurrence.dueAt|datetime('short') }}</td>
                        <td>
                            <a href="{{ url('schedulr/notifications/' ~ occurrence.notificationId) }}">
                                {{ titles[occurrence.notificationId] ?? '(deleted)'|t('schedulr') }}
                            </a>
                        </td>
                        <td>{{ occurrence.getStatusLabel() }}</td>
                        <td>{{ occurrence.targeted|number_format }}</td>
                        <td>{{ occurrence.delivered|number_format }}</td>
                        <td>{{ occurrence.failed ? occurrence.failed|number_format : '' }}</td>
                    </tr>
                    {% if occurrence.lastError %}
                        <tr><td colspan="6" class="light smalltext">{{ occurrence.lastError }}</td></tr>
                    {% endif %}
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p class="zilch small">{{ 'Nothing has been sent yet.'|t('schedulr') }}</p>
    {% endif %}

    {% if canSend %}
        {% include 'schedulr/_components/_cp-js' %}

        {% js %}
            // Present because the first thing anybody does when a scheduled send has not arrived is
            // look for a button that makes it happen, and the second is to reach for a console they
            // cannot open.
            $('#run-now').on('click', function() {
                SchedulrCp.post($(this), 'schedulr/schedule/run').then(function(response) {
                    if (response) { window.location.reload(); }
                });
            });
        {% endjs %}
    {% endif %}
{% endblock %}

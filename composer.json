{
    "name": "justinholtweb/craft-schedulr",
    "description": "Scheduled notifications for Craft — web push, email and on-site, written once and delivered on a schedule, in a segment, or in each subscriber's own time zone.",
    "type": "craft-plugin",
    "version": "5.0.0",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "notifications",
        "web push",
        "push notifications",
        "scheduled",
        "segments",
        "automation",
        "onesignal"
    ],
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Justin Holt",
            "homepage": "https://justinholt.com"
        }
    ],
    "support": {
        "email": "justin@justinholt.com",
        "docs": "https://justinholt.com/plugins/craft-schedulr/docs",
        "source": "https://github.com/justinholtweb/craft-schedulr",
        "issues": "https://github.com/justinholtweb/craft-schedulr/issues"
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-openssl": "*",
        "craftcms/cms": "^5.3.0"
    },
    "require-dev": {
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main",
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.12 || ^2.2"
    },
    "autoload": {
        "psr-4": {
            "justinholtweb\\schedulr\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "justinholtweb\\schedulr\\tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "check-cs": "ecs check --ansi",
        "fix-cs": "ecs check --fix --ansi",
        "phpstan": "phpstan --memory-limit=1G"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true,
            "craftcms/generator": true
        }
    },
    "extra": {
        "name": "Schedulr",
        "handle": "schedulr",
        "developer": "Justin Holt",
        "developerUrl": "https://justinholt.com",
        "documentationUrl": "https://justinholt.com/plugins/craft-schedulr/docs",
        "changelogUrl": "https://raw.githubusercontent.com/justinholtweb/craft-schedulr/main/CHANGELOG.md",
        "class": "justinholtweb\\schedulr\\Plugin"
    }
}
